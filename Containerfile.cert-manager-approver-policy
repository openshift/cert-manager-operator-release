FROM registry.redhat.io/openshift/golang-builder:golang-builder-v1.26-rhel9 AS builder

ARG SOURCE_DIR="/go/src/github.com/openshift/cert-manager-approver-policy"
WORKDIR $SOURCE_DIR

COPY cert-manager-approver-policy $SOURCE_DIR
COPY cert-manager-approver-policy/LICENSE /licenses/

ENV GO_BUILD_TAGS=strictfipsruntime,openssl
ENV GOEXPERIMENT=strictfipsruntime
ENV CGO_ENABLED=1
ENV GOFLAGS=""

RUN cd $SOURCE_DIR/cmd && go build -o $SOURCE_DIR/_output/cert-manager-approver-policy -ldflags '-w -s' -tags ${GO_BUILD_TAGS} main.go

FROM registry.redhat.io/ubi9/ubi-minimal-pqc:latest@sha256:9aca95ae4e261eab848dc6abdfd08eb4c2453944232021245b2e3108eb25ae18

# Values for below ARGs will passed from tekton configs for konflux builds.
## Release version of the cert-manager source code used in the build.
ARG RELEASE_VERSION
## Commit hash that considered for the image build.
ARG COMMIT_SHA
## github URL of the cert-manager source repository.
ARG SOURCE_URL
ARG SOURCE_DIR="/go/src/github.com/openshift/cert-manager-approver-policy"

COPY --from=builder $SOURCE_DIR/_output/cert-manager-approver-policy /usr/local/bin/cert-manager-approver-policy
COPY --from=builder /licenses /licenses

USER 65534:65534

LABEL com.redhat.component="cert-manager-approver-policy-container" \
      cpe="cpe:/a:redhat:cert_manager:1.21::el9" \
      name="cert-manager/cert-manager-approver-policy-rhel9" \
      version="${RELEASE_VERSION}" \
      summary="cert-manager-approver-policy" \
      maintainer="Red Hat, Inc." \
      description="cert-manager-approver-policy-container" \
      vendor="Red Hat, Inc." \
      release="${RELEASE_VERSION}" \
      io.openshift.expose-services="" \
      io.openshift.tags="data,images,cert-manager-approver-policy" \
      io.openshift.build.commit.id="${COMMIT_SHA}" \
      io.openshift.build.source-location="${SOURCE_URL}" \
      io.openshift.build.commit.url="${SOURCE_URL}/commit/${COMMIT_SHA}" \
      io.k8s.display-name="cert-manager-approver-policy" \
      io.k8s.description="cert-manager-approver-policy-container"

ENTRYPOINT ["/usr/local/bin/cert-manager-approver-policy"]
